# Copia este archivo como .env (en la raíz del proyecto, fuera de public/) y rellénalo.

# Contraseña para entrar en /inscritos.php. Si se deja vacía, el panel queda desactivado.
ADMIN_PASSWORD=

# Correo de confirmación ("Gracias por inscribirse…") a quien se apunta.
# Remitente: conviene que sea un buzón real del dominio desde el que el servidor puede enviar
# (si no, el correo puede acabar en spam). Si se deja vacío se usa ots@scrapenvases.com.
MAIL_FROM=ots@scrapenvases.com
MAIL_FROM_NAME=SCRAPenvases.com

# Dirección pública de la web (para el logo y el enlace a la Política de Privacidad del correo).
SITE_URL=https://webinar.scrapenvases.com

# Opcional: correo que recibe un aviso con cada inscripción nueva.
NOTIFY_EMAIL=

# Los correos salen por Amazon SES usando el rol IAM de la instancia EC2 (app/ses.php, sin claves).
# Si no hay rol o SES falla, se intenta mail() de PHP (requiere un servidor de correo en la máquina).
